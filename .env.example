# --- Runtime ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# Database (Prisma)
# Local development: DB_PROVIDER=sqlite and DATABASE_URL=file:./dev.db
# Production: DB_PROVIDER=postgresql and DATABASE_URL=postgresql://...
DB_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# JWT access tokens and opaque refresh tokens (generate strong secrets, e.g. openssl rand -base64 48)
JWT_ACCESS_SECRET=REPLACE_ME_use_openssl_rand_base64_48________
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Email (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <noreply@example.com>"
SMTP_SECURE=false

# If true: sends verification on signup, does NOT issue tokens until email is verified; login is blocked until verified.
EMAIL_VERIFICATION_ON_SIGNUP=false

# --- HTTP / security ---
# Comma-separated origins for browser clients, or * for open non-credentialed access in development.
# Production: must be an explicit list (wildcard * is rejected by env validation).
CORS_ORIGIN=*
# Must be false when CORS_ORIGIN is *. Set true only with an explicit allowlist of real origins.
CORS_CREDENTIALS=false
TRUST_PROXY=
# TRUST_PROXY can be: true | false | number (hop count). Set appropriately behind reverse proxies.

# --- Rate limit (global + stricter /auth routes) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# --- Logging ---
LOG_LEVEL=info
ENABLE_REQUEST_LOGS=true
ENABLE_DEBUG_LOGS=false
ENABLE_STACK_TRACE=false
