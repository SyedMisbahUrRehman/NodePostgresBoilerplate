# --- Runtime ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# Database (Prisma)
# Local development: DB_PROVIDER=sqlite and DATABASE_URL=file:./dev.db
# Production: DB_PROVIDER=postgresql and DATABASE_URL=postgresql://...
DB_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# JWT (min 32 chars each in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Email (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <noreply@example.com>"
SMTP_SECURE=false

# If true, sends verification email on signup and expects POST /auth/verify-email
EMAIL_VERIFICATION_ON_SIGNUP=false

# --- HTTP / security ---
CORS_ORIGIN=*
TRUST_PROXY=
# TRUST_PROXY can be: true | false | number (hop count)

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=info
ENABLE_REQUEST_LOGS=true
ENABLE_DEBUG_LOGS=false
ENABLE_STACK_TRACE=false
