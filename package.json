{
  "name": "node-postgres-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "db:generate": "node scripts/prisma.js generate",
    "db:migrate": "node scripts/prisma.js migrate dev",
    "db:push": "node scripts/prisma.js db push",
    "db:studio": "node scripts/prisma.js studio",
    "db:generate:postgres": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:postgres": "prisma migrate dev --schema prisma/schema.prisma",
    "db:generate:sqlite": "prisma generate --schema prisma/sqlite/schema.prisma",
    "db:migrate:sqlite": "prisma migrate dev --schema prisma/sqlite/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nodemailer": "^7.0.3",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
